# ⚠️ NO habilitar en el servidor de McKenna: el :8081 lo sirve `agente-pro.service`
# (ver scripts/systemd/agente-pro.service). Esta unidad quedó deshabilitada el
# 12-sep-2026 porque tener las dos enabled la dejó en `failed` con
# "Address already in use" desde el 8-sep. Se conserva como plantilla para una
# instalación nueva donde agente-pro no exista — pero una sola, nunca ambas.
#
# Agente principal Flask :8081 + CLI (mismo proceso que agente_pro.py).
#
#   sudo cp scripts/systemd/mckenna-agente.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mckenna-agente
#
# Si usas esta unidad, desactiva el nohup de agente_pro en mantener_servicios / start_services
# (el guard lo omite automáticamente cuando la unidad está activa).

[Unit]
Description=McKenna Agente Hugo García (Flask :8081 + CLI)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=mckg
Group=mckg
WorkingDirectory=/home/mckg/mi-agente
EnvironmentFile=-/home/mckg/mi-agente/.env
ExecStart=/home/mckg/mi-agente/venv/bin/python3 -u /home/mckg/mi-agente/agente_pro.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
